--- a/src/services/report_service.py
+++ b/src/services/report_service.py
@@ -0,0 +1,22 @@
+"""Application katmanı: rapor verisi ve postalama.
+
+`arch` koşulunda `openai/gpt-oss-20b`'nin önerdiği sınıf, taslakta verildiği
+gibi uygulanmıştır.
+"""
+
+from __future__ import annotations
+
+from infra.email_client import EmailClient
+from infra.order_repository import OrderRepository
+
+
+class ReportService:
+    def __init__(self, repo: OrderRepository, mailer: EmailClient) -> None:
+        self._repo = repo
+        self._mailer = mailer
+
+    def order_count(self) -> int:
+        return self._repo.count()
+
+    def mail_summary(self, address: str) -> dict[str, str]:
+        return self._mailer.send(address, f"{self._repo.count()} orders")
