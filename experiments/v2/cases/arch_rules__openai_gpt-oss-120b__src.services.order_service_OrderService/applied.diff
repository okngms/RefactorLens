 from domain.policies import DiscountPolicy
 
 
+class NotificationService:
+    def __init__(self, notifier):
+        self._notifier = notifier
+        self._sent = 0
+
+    def notify(self, customer, subject):
+        result = self._notifier.send(customer.email(), subject)
+        self._sent += 1
+        return result
+
+    def sent_count(self):
+        return self._sent
+
+    def reset_sent(self):
+        previous = self._sent
+        self._sent = 0
+        return previous
+
